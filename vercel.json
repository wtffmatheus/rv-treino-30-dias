{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,

  "rewrites": [
    {
      "source": "/entrar",
      "destination": "/login"
    },
    {
      "source": "/meus-cursos",
      "destination": "/aluno"
    },
    {
      "source": "/checkout/rv30",
      "destination": "/checkout?curso=rv30"
    },
    {
      "source": "/curso/rv30",
      "destination": "/area"
    },
    {
      "source": "/curso/rv30/dia/:day",
      "destination": "/area?day=:day"
    },
    {
      "source": "/pagamento/sucesso",
      "destination": "/pagamento-confirmado"
    },
    {
      "source": "/admin/entrar",
      "destination": "/admin-login"
    },
    {
      "source": "/admin/videos",
      "destination": "/admin-videos"
    },
    {
      "source": "/admin/suporte",
      "destination": "/suporte?perfil=admin"
    }
  ],

  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; frame-src https://www.youtube-nocookie.com https://player.vimeo.com; img-src 'self' data: https://rvfisiologista.com.br; style-src 'self'; script-src 'self'; connect-src 'self'; media-src 'self' https://rvfisiologista.com.br; font-src 'self'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    }
  ]
}