{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/suporte", "destination": "/suporte.html" },
    { "source": "/admin/suporte", "destination": "/suporte.html?perfil=admin" },
    { "source": "/admin/videos", "destination": "/admin-videos.html" },
    {
      "source": "/entrar",
      "destination": "/login.html"
    },
    {
      "source": "/aluno",
      "destination": "/aluno.html"
    },
    {
      "source": "/meus-cursos",
      "destination": "/aluno.html"
    },
    {
      "source": "/checkout/rv30",
      "destination": "/checkout.html?curso=rv30"
    },
    {
      "source": "/curso/rv30",
      "destination": "/area.html"
    },
    {
      "source": "/curso/rv30/dia/:day",
      "destination": "/area.html?day=:day"
    },
    {
      "source": "/pagamento-confirmado",
      "destination": "/pagamento-confirmado.html"
    },
    {
      "source": "/pagamento/sucesso",
      "destination": "/pagamento-confirmado.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/entrar",
      "destination": "/admin-login.html"
    },
    {
      "source": "/privacidade",
      "destination": "/privacidade.html"
    },
    {
      "source": "/termos",
      "destination": "/termos.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; frame-src https://www.youtube-nocookie.com https://player.vimeo.com; img-src 'self' data: https://rvfisiologista.com.br; style-src 'self'; script-src 'self'; connect-src 'self'; media-src 'self' https://rvfisiologista.com.br; font-src 'self'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    }
  ]
}
