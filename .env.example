# Node 22+ server reads ignored .env locally; static dist does not read it.
# All variables below stay on the server. Never commit a completed .env.
# Use a separate Supabase project and payment account for staging.
PUBLIC_SITE_URL=http://127.0.0.1:8081
NODE_ENV=development
PORT=8081
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Verified account invited through protected Supabase administration.
# Blank keeps all administrative APIs blocked. Public signup reserves this email.
ADMIN_EMAIL=
# Prepared adapter, not an approved choice of commercial provider.
PAYMENT_PROVIDER=
PAYMENT_ENVIRONMENT=test
RV30_SALES_ENABLED=false
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_COLLECTOR_ID=
# Decision required before opening sales: review | revoke | preserve.
# review records refund/chargeback and keeps existing access awaiting review.
RV30_REFUND_ACCESS_POLICY=review
