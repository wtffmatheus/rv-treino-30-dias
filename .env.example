# Node 22+ server reads ignored .env locally; static dist does not read it.
# All variables below stay on the server. Never commit a completed .env.
# Use a separate Supabase project and payment account for staging.
PUBLIC_SITE_URL=http://127.0.0.1:8081
NODE_ENV=development
PORT=8081
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Verified account invited through protected Supabase administration.
# Blank keeps all administrative APIs blocked. Public signup reserves this email.
ADMIN_EMAIL=
# Asaas prioritizes the owner's lowest-fee, no-advance settlement preference.
PAYMENT_PROVIDER=asaas
PAYMENT_ENVIRONMENT=test
RV30_SALES_ENABLED=false
# Sandbox and production have separate accounts, keys and webhook settings.
ASAAS_API_KEY=
ASAAS_ACCOUNT_ID=
ASAAS_WEBHOOK_TOKEN=
ASAAS_INTEGRATION_VERIFIED=false
# Confirm the offset of naive dateCreated timestamps during sandbox validation.
# Explicit ISO timestamps with timezone do not need conversion.
ASAAS_WEBHOOK_UTC_OFFSET=
# Fixed policy: confirmed refunds/chargebacks revoke RV 30 access.
RV30_REFUND_ACCESS_POLICY=revoke
